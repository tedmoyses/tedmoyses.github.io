{%- set pageTitle = "Ted Moyses" if page.url == "/" else ((title or "Ted Moyses") + " | Ted Moyses") -%}
{%- set metaDescription = (description or summary or site.description) | striptags -%}
{%- set canonicalUrl = page.url | absoluteUrl(site.url) -%}
{%- set socialImage = hero_image | absoluteUrl(site.url) -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:type" content="{{ og_type or 'website' }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:site_name" content="{{ site.name }}">
  {% if hero_image %}
  <meta property="og:image" content="{{ socialImage }}">
  {% endif %}
  <meta name="twitter:card" content="{{ 'summary_large_image' if hero_image else 'summary' }}">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ metaDescription }}">
  {% if hero_image %}
  <meta name="twitter:image" content="{{ socialImage }}">
  {% endif %}
  {% if og_type == "article" and date %}
  <meta property="article:published_time" content="{{ date | htmlDateString }}">
  {% endif %}
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} — Thoughts" href="{{ '/feed.xml' | absoluteUrl(site.url) }}">
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%231b4332'/><text x='16' y='22' font-size='14' text-anchor='middle' fill='%23fff8f3' font-family='system-ui' font-weight='600'>TM</text></svg>" media="(prefers-color-scheme: light)">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23f59e0b'/><text x='16' y='22' font-size='14' text-anchor='middle' fill='%230f1012' font-family='system-ui' font-weight='600'>TM</text></svg>" media="(prefers-color-scheme: dark)">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ site.name | json | safe }},
    "url": {{ site.url | json | safe }},
    "description": {{ site.description | json | safe }}
  }
  </script>
  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": {{ site.author | json | safe }},
    "url": {{ site.url | json | safe }},
    "sameAs": [
      {{ site.social.github | json | safe }},
      {{ site.social.twitter | json | safe }},
      {{ site.social.linkedin | json | safe }}
    ]
  }
  </script>
  {% endif %}
  {% if og_type == "article" and title %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | json | safe }},
    "datePublished": {{ date | htmlDateString | json | safe }},
    "author": { "@type": "Person", "name": {{ site.author | json | safe }} },
    "url": {{ canonicalUrl | json | safe }},
    "description": {{ metaDescription | json | safe }}{% if hero_image %},
    "image": {{ socialImage | json | safe }}{% endif %}
  }
  </script>
  {% endif %}
</head>
<body>

  <header class="site-header">
    <div class="header-inner container">
      <a href="/" class="site-brand">Ted Moyses</a>
      <a href="/" class="avatar-badge" aria-label="About">
        <span class="avatar-letter">TM</span>
      </a>
    </div>
  </header>

  <main class="container">
    {{ content | safe }}
  </main>

  <nav class="bottom-tab-bar" aria-label="Primary navigation">
    <div class="tab-inner">
      <a href="/" class="tab-item {% if page.url == '/' %}active{% endif %}">
        {% include "icons/about.svg" %}
        <span>About</span>
      </a>
      <a href="/history/" class="tab-item {% if page.url == '/history/' %}active{% endif %}">
        {% include "icons/history.svg" %}
        <span>History</span>
      </a>
      <a href="/projects/" class="tab-item {% if page.url == '/projects/' %}active{% endif %}">
        {% include "icons/projects.svg" %}
        <span>Projects</span>
      </a>
      <a href="/thoughts/" class="tab-item {% if page.url == '/thoughts/' %}active{% endif %}">
        {% include "icons/thoughts.svg" %}
        <span>Thoughts</span>
      </a>
    </div>
  </nav>

  {% if isProduction and analytics.cloudflareToken %}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ analytics.cloudflareToken }}"}'></script>
  {% endif %}

</body>
</html>
