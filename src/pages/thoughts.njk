---
layout: layouts/base.njk
title: Thoughts
permalink: /thoughts/
---

<header class="page-intro">
  <div class="meta-mono subhead"><span class="bullet">•</span> Archive / Notes</div>
  <h1 class="page-title">Thoughts</h1>
</header>

<section class="content-section">
  {% for post in collections.posts %}
  <article class="blog-entry">
    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    <p class="blog-date">{{ post.date | date("YYYY/MM/DD") }}</p>
    <p>{{ post.templateContent | striptags | truncate(200) }}</p>
  </article>
  {% else %}
  <p>Nothing written yet. Stay tuned.</p>
  {% endfor %}
</section>
