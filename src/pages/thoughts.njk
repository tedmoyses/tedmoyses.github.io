---
layout: layouts/base.njk
title: Thoughts
description: Notes, essays and updates on projects, infrastructure and technology.
permalink: /thoughts/
---

<header class="page-intro">
  <div class="meta-mono subhead">
    <span class="bullet">•</span>
    <span>Index / <span aria-current="page">Thoughts</span></span>
    <span class="count">[{{ collections.posts | length }}]</span>
  </div>
  <h1 class="page-title">Thoughts</h1>
</header>

<section class="content-section">
  {% for post in collections.posts %}
  <article class="blog-entry">
    {% set cardImage = post.data.hero_image_thumb or post.data.hero_image %}
    {% if cardImage %}
      {% if post.data.hero_image_thumb %}
        {% set cardWidth = post.data.hero_image_thumb_width or 800 %}
        {% set cardHeight = post.data.hero_image_thumb_height or 450 %}
      {% else %}
        {% set cardWidth = post.data.hero_image_width or 1200 %}
        {% set cardHeight = post.data.hero_image_height or 630 %}
      {% endif %}
      <img class="blog-thumb" src="{{ cardImage }}" alt="{{ post.data.hero_image_alt or post.data.title }}" width="{{ cardWidth }}" height="{{ cardHeight }}" loading="lazy">
    {% endif %}
    <div class="blog-meta">
      <time class="blog-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
      {% if post.data.series %}
      <span class="series-label">Series · {{ post.data.series }}</span>
      {% endif %}
    </div>
    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    <p>{{ post.data.summary or post.templateContent | striptags | truncate(200) }}</p>
    <a href="{{ post.url }}" class="read-more">Read entry {% include "icons/arrow-right.svg" %}</a>
  </article>
  {% else %}
  <p>Nothing written yet. Stay tuned.</p>
  {% endfor %}
</section>
