---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.name | xmlEscape }} — Thoughts</title>
    <link>{{ site.url }}/thoughts/</link>
    <description>{{ site.description | xmlEscape }}</description>
    <language>en</language>
    <lastBuildDate>{{ now | rssDate }}</lastBuildDate>
    <atom:link href="{{ '/feed.xml' | absoluteUrl(site.url) }}" rel="self" type="application/rss+xml" />
    {%- for post in collections.posts %}
    <item>
      <title>{{ post.data.title | xmlEscape }}</title>
      <link>{{ post.url | absoluteUrl(site.url) }}</link>
      <guid isPermaLink="true">{{ post.url | absoluteUrl(site.url) }}</guid>
      <pubDate>{{ post.date | rssDate }}</pubDate>
      {%- set feedDescription = (post.data.summary or post.templateContent) | striptags | truncate(280) %}
      <description>{{ feedDescription | xmlEscape }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
